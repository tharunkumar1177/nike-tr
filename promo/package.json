{
  "name": "tron-promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts TronPromo out/promo.mp4 --codec=h264",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@remotion/cli": "4.0.535",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
